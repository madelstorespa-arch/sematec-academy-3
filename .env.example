# ── Supabase (Project Settings → API) ─────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://<tu-proyecto>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-public-key>
# SECRETO: solo en el servidor (Vercel → Environment Variables). Nunca en GitHub.
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# ── Dirección pública de la plataforma ────────────────────────────
NEXT_PUBLIC_SITE_URL=https://academy.sematec.cl

# ── LiveKit Cloud (Settings → Keys) ───────────────────────────────
NEXT_PUBLIC_LIVEKIT_URL=wss://<tu-proyecto>.livekit.cloud
LIVEKIT_API_KEY=<api-key>
LIVEKIT_API_SECRET=<api-secret>

# ── Pagos en línea (configure solo los que usará) ─────────────────
PAYMENT_LINK_SECRET=<texto-aleatorio-largo>
# Webpay Plus (Transbank)
WEBPAY_ENABLED=1
WEBPAY_ENV=production
WEBPAY_COMMERCE_CODE=<codigo-de-comercio>
WEBPAY_API_KEY=<api-key-secreta>
# Mercado Pago
MERCADOPAGO_ACCESS_TOKEN=<access-token>
MERCADOPAGO_WEBHOOK_SECRET=<clave-secreta-webhooks>
# Flow
FLOW_ENV=production
FLOW_API_KEY=<api-key>
FLOW_SECRET_KEY=<secret-key>
# Stripe
STRIPE_SECRET_KEY=<sk_live_...>
STRIPE_WEBHOOK_SECRET=<whsec_...>
